# Makefile for testing blockchain functionality
# This demonstrates how to compile the blockchain code for testing

CXX = g++
CXXFLAGS = -std=c++17 -Wall -I.
LDFLAGS = -lcurl -pthread

# Source files
BLOCKCHAIN_SRC = blockchain.cpp
TEST_SRC = test_blockchain.cpp
BLOCKCHAIN_HDR = blockchain.h

# Output binary
TEST_BIN = test_blockchain

# JSON library (header-only)
JSON_INCLUDE = -I/usr/include/nlohmann

.PHONY: all clean test help

all: $(TEST_BIN)

$(TEST_BIN): $(BLOCKCHAIN_SRC) $(TEST_SRC) $(BLOCKCHAIN_HDR)
	@echo "Compiling blockchain test program..."
	$(CXX) $(CXXFLAGS) $(JSON_INCLUDE) $(BLOCKCHAIN_SRC) $(TEST_SRC) -o $(TEST_BIN) $(LDFLAGS)
	@echo "✓ Build complete: ./$(TEST_BIN)"

test: $(TEST_BIN)
	@echo "Running blockchain test..."
	@echo "========================================"
	./$(TEST_BIN) 1.4.2

clean:
	rm -f $(TEST_BIN)
	@echo "✓ Cleaned build artifacts"

help:
	@echo "Blockchain Test Makefile"
	@echo "========================"
	@echo "make          - Build the test program"
	@echo "make test     - Build and run test with version 1.4.2"
	@echo "make clean    - Remove build artifacts"
	@echo "make help     - Show this help message"
	@echo ""
	@echo "Usage examples:"
	@echo "  ./test_blockchain              # Test with default version 1.4.2"
	@echo "  ./test_blockchain 1.5.0        # Test with specific version"
	@echo ""
	@echo "Requirements:"
	@echo "  - libcurl-dev (sudo apt-get install libcurl4-openssl-dev)"
	@echo "  - nlohmann-json (sudo apt-get install nlohmann-json3-dev)"
